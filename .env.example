# ==============================================================================
# SesliKitap Ortam Yapılandırması (.env)
# Başka bir bilgisayara kurarken bu dosyayı ".env" olarak kopyalayın:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
# ==============================================================================

# ---------- Genel & Güvenlik ----------
ASPNETCORE_ENVIRONMENT=Development
ADMIN_API_KEY=I3PFUCmsvNqOy2dXvlWi-bOQp84Amh4SyvNizZb5trLl0MBeiDSXrF2QMaTd7ErL
MEDIA_TOKEN_SECRET=DPpryL72Br7My2vFYZdwPItlvpgw8nyHg6lPFZBPZJy5FAO_-QVyOvfZps7xs8d1
CORS_ALLOWED_ORIGINS=http://localhost:4300

# ---------- PostgreSQL (Docker: 5433 -> 5432) ----------
DB_HOST=localhost
DB_PORT=5433
DB_NAME=seslikitap
DB_USER=postgres
DB_PASSWORD=postgres

# ---------- Redis (Docker: 6380 -> 6379) ----------
REDIS_CONNECTION_STRING=localhost:6380

# ---------- RabbitMQ (Docker: 5673 -> 5672) ----------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ---------- MinIO Nesne Depolama (Docker: 9010 -> 9000, Web: 9011) ----------
MINIO_ENDPOINT=localhost:9010
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=seslikitap
MINIO_USE_SSL=false

# ---------- TTS & Modal.com GPU Sunucusu ----------
TTS_ENGINE_ORDER=voxcpm2_modal,voxcpm2_alt,xtts2_modal
ALLOW_MOCK_TTS=false

# Buluttaki hazır Modal L4 Trendyol Türkçe TTS sunucu adresi:
TTS_MODAL_URL=https://ustunmuhammed09--seslikitap-tts-voxcpm2-trendyol-voxcpms-edce4b.us-east.modal.run
TTS_MODAL_HEALTH_URL=https://ustunmuhammed09--seslikitap-tts-voxcpm2-trendyol-voxcpms-edce4b.us-east.modal.run/v1/health
TTS_MODAL_URL_BASE=https://ustunmuhammed09--seslikitap-tts-voxcpm2-voxcpmserver-web.us-east.modal.run
TTS_MODAL_URL_TRENDYOL=https://ustunmuhammed09--seslikitap-tts-voxcpm2-trendyol-voxcpms-edce4b.us-east.modal.run

# Modal TTS API Güvenlik Belirteci:
TTS_API_TOKEN=2fUTvdSOICT7zPeW3n0Dl4b-YHAHsW4KDfez45AaijePxdB3KunsOrwxMlea70pU

TTS_BATCH_SIZE=16
TTS_MAX_CONCURRENT_REQUESTS=2
TTS_REQUEST_TIMEOUT_SEC=600
TTS_COLD_START_TIMEOUT_SEC=300
TTS_MAX_RETRIES=3
TTS_MAX_CHUNK_CHARS=480
TTS_MIN_CHUNK_CHARS=70
TTS_GPU_PRICE_PER_HOUR_USD=0.80
TTS_IDLE_OVERHEAD_FACTOR=1.15
TTS_ESTIMATED_RTF=0.20
TTS_MONTHLY_BUDGET_USD=30

# ---------- Python Worker (Docker İçi Bağlantılar) ----------
API_BASE_URL=http://host.docker.internal:5201
WORKER_TEMP_DIR=/app/temp
TEMP_RETENTION=after_job
LOG_LEVEL=INFO

# ---------- Keşif & Arama (İsteğe Bağlı) ----------
DISCOVERY_WEBSEARCH_ENABLED=false
SEARXNG_URL=http://searxng:8080
